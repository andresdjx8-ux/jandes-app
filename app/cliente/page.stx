"use client";
import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!);

function LogoJandes() {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 8[STRIPPED 22 bytes]"44" height="28" viewBox="0 0 88 56" fill="none">
        <path d="M4 52 L28 16 L40 34 L52 10 L84 52 Z" fill="#2563eb" />
        <path d="M28 16 L34 24 L29 27 L25 23 L21 27 L22 28 L28 16 Z" fill="white" />
        <path d="M52 10 L58 19 L53 22 L49 18 L45 22 L46 23 L52 10 Z" fill="white" />
      </svg>
      <span style={{ fontSize: 26, fontWeight: 900, letterSpacing: 2 }}>
        <span style={{ color: "#2563eb" }}>JAN</span><span style={{ color: "#1d4ed8" }}>DES</span>
      </span>
    </div>
  );
}

export default function Cliente() {
  const router = useRouter();
  const [comercios, setComercios] = useState<any[]>([]);
  const [promos, setPromos] = useState<any[]>([]);
  const [pedidos, setPedidos] = useState<any[]>([]);
  const [cargando, setCargando] = useState(true);
  const [tab, setTab] = useState<"inicio" | "pedidos">("inicio");

  useEffect(() => { cargar(); }, []);

  async function cargar() {
    const { data: userData } = await supabase.auth.getUser();
    if (!userData.user) { router.push("/login"); return; }

    const { data: com } = await supabase.from("comercios").select("*").eq("abierto", true).order("nombre");
    if (com) setComercios(com);

    const { data: pr } = await supabase.from("promos").select("*").order("created_at", { ascending: false }).limit(10);
    if (pr) setPromos(pr);

    const { data: ped } = await supabase.from("pedidos").select("*, comercios(nombre)").eq("user_id", userData.user.id).order("created_at", { ascending: false }).limit(20);
    if (ped) setPedidos(ped);

    setCargando(false);
  }

  async function salir() {
    await supabase.auth.signOut();
    router.push("/login");
  }

  if (cargando) return <div style={{ minHeight: "100vh", background: "#0f172a", color: "white", display: "flex", justifyContent: "center", alignItems: "center" }}>Cargando JANDES...</div>;

  return (
    <div style={{ minHeight: "100vh", background: "#f1f5f9", paddingBottom: 80 }}>
      {/* HEADER */}
      <div style={{ background: "white", padding: "12px 16px", display: "flex", justifyContent: "space-between", alignItems: "center", position: "sticky", top: 0, zIndex: 10, boxShadow: "0 2px 10px rgba(0,0,0,0.08)" }}>
        <LogoJandes />
        <button onClick={salir} style={{ border: "none", background: "#f1f5f9", padding: "8px 14px", borderRadius: 10, fontWeight: 700, cursor: "pointer" }}>Salir</button>
      </div>

      <div style={{ padding: 16, maxWidth: 600, margin: "0 auto" }}>
        {/* TABS */}
        <div style={{ display: "flex", gap: 8, marginBottom: 16, background: "white", padding: 4, borderRadius: 12 }}>
          <button onClick={() => setTab("inicio")} style={{ flex: 1, padding: 11, borderRadius: 9, border: "none", fontWeight: 800, cursor: "pointer", background: tab === "inicio" ? "#2563eb" : "transparent", color: tab === "inicio" ? "white" : "#333" }}>🏠 Inicio</button>
          <button onClick={() => setTab("pedidos")} style={{ flex: 1, padding: 11, borderRadius: 9, border: "none", fontWeight: 800, cursor: "pointer", background: tab === "pedidos" ? "#2563eb" : "transparent", color: tab === "pedidos" ? "white" : "#333" }}>🧾 Mis Pedidos ({pedidos.length})</button>
        </div>

        {tab === "inicio" && (
          <>
            {/* PROMOS */}
            {promos.length > 0 && (
              <>
                <h2 style={{ fontSize: 18, fontWeight: 900, margin: "4px 0 10px" }}>🔥 Promos del día</h2>
                <div style={{ display: "flex", gap: 10, overflowX: "auto", paddingBottom: 8, marginBottom: 8 }}>
                  {promos.map((p: any) => (
                    <div key={p.id} style={{ minWidth: 180, background: "white", borderRadius: 14, padding: 12, boxShadow: "0 2px 8px rgba(0,0,0,0.06)" }}>
                      <div style={{ fontSize: 28 }}>🎁</div>
                      <div style={{ fontWeight: 800, fontSize: 14 }}>{p.titulo || p.nombre}</div>
                      <div style={{ fontSize: 12, color: "#666" }}>{p.descripcion || ""}</div>
                      {p.precio && <div style={{ fontWeight: 900, color: "#2563eb", marginTop: 4 }}>${p.precio}</div>}
                    </div>
                  ))}
                </div>
              </>
            )}

            {/* COMERCIOS */}
            <h2 style={{ fontSize: 18, fontWeight: 900, margin: "10px 0" }}>Kioscos abiertos ahora ({comercios.length})</h2>
            {comercios.length === 0 && <div style={{ background: "white", padding: 20, borderRadius: 14, textAlign: "center", color: "#666" }}>No hay comercios abiertos ahora. Volvé en un rato.</div>}
            {comercios.map((c: any) => (
              <div key={c.id} onClick={() => router.push(`/kiosco/${c.id}`)} style={{ background: "white", borderRadius: 16, padding: 16, marginBottom: 12, cursor: "pointer", boxShadow: "0 2px 10px rgba(0,0,0,0.06)", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <div>
                  <div style={{ fontWeight: 900, fontSize: 17 }}>{c.nombre}</div>
                  <div style={{ fontSize: 12, color: "#666" }}>{c.descripcion || "solo delivery"} • Entrega 15-25 min</div>
                  <span style={{ display: "inline-block", marginTop: 6, background: "#dcfce7", color: "#166534", fontSize: 11, fontWeight: 800, padding: "3px 8px", borderRadius: 20 }}>● Abierto</span>
                </div>
                <div style={{ fontSize: 26 }}>➡️</div>
              </div>
            ))}
          </>
        )}

        {tab === "pedidos" && (
          <>
            <h2 style={{ fontSize: 18, fontWeight: 900, margin: "4px 0 10px" }}>Mis Pedidos</h2>
            {pedidos.length === 0 && <div style={{ background: "white", padding: 20, borderRadius: 14, textAlign: "center", color: "#666" }}>Todavía no pediste nada. ¡Pedí algo rico!</div>}
            {pedidos.map((p: any) => (
              <div key={p.id} style={{ background: "white", borderRadius: 16, padding: 14, marginBottom: 10, boxShadow: "0 2px 8px rgba(0,0,0,0.06)" }}>
                <div style={{ display: "flex", justifyContent: "space-between" }}>
                  <b>Pedido #{p.id} - {p.comercios?.nombre || "Comercio"}</b>
                  <span style={{ fontSize: 12, fontWeight: 800, background: p.estado === "entregado" ? "#dcfce7" : "#dbeafe", color: p.estado === "entregado" ? "#166534" : "#1d4ed8", padding: "3px 8px", borderRadius: 20 }}>{p.estado || "pendiente"}</span>
                </div>
                <div style={{ fontSize: 13, color: "#555", marginTop: 6 }}>Total: ${p.total || p.total_pedido || "—"} • {p.direccion_entrega || ""}</div>
                <button onClick={() => router.push(`/kiosco/${p.comercio_id}`)} style={{ marginTop: 10, width: "100%", padding: 10, borderRadius: 10, border: "none", background: "#0f172a", color: "white", fontWeight: 700, cursor: "pointer" }}>Ver / Chatear</button>
              </div>
            ))}
          </>
        )}
      </div>
    </div>
  );
}